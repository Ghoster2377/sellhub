# Скопируйте этот файл в .env и заполните своими ключами.
# .env НЕ попадает в git (см. .gitignore).
#
# FUNPAY_GOLDEN_KEY: FunPay -> Настройки профиля -> раздел Golden Key
# PLAYEROK_TOKEN:    playerok.com -> F12 (DevTools) -> Network -> любой запрос
#                    graphql -> заголовок Authorization (скопировать значение токена)
#
# Вместо .env ключи можно ввести прямо в панели: Настройки -> Подключить
# (они сохранятся в data/credentials.json на сервере).

FUNPAY_GOLDEN_KEY=
PLAYEROK_TOKEN=
